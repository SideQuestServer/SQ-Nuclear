{
  "multipart": [
    {
      "when": {
        "part": "1|2|3"
      },
      "apply": {
        "model": "nuclearsq:block/solar_collector_sqc_part"
      }
    },
    {
      "when": {
        "part": "0"
      },
      "apply": {
        "model": "nuclearsq:block/solar_collector_sqc_big_base"
      }
    },
    {
      "when": {
        "part": "4"
      },
      "apply": {
        "model": "nuclearsq:block/solar_collector_sqc_base"
      }
    },
    {
      "when": {
        "part": "0",
        "port": "0"
      },
      "apply": {
        "model": "nuclearsq:block/solar_collector_sqc_power_port"
      }
    },
    {
      "when": {
        "part": "1",
        "port": "1"
      },
      "apply": {
        "model": "nuclearsq:block/solar_collector_sqc_power_port"
      }
    },
    {
      "when": {
        "part": "2",
        "port": "2"
      },
      "apply": {
        "model": "nuclearsq:block/solar_collector_sqc_power_port",
        "y": 180
      }
    },
    {
      "when": {
        "part": "3",
        "port": "3"
      },
      "apply": {
        "model": "nuclearsq:block/solar_collector_sqc_power_port",
        "y": 180
      }
    }
  ]
}
